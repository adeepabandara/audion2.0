# Copy to .env for local development. Never commit .env.
# The API authenticates to Google with Application Default Credentials
# (`gcloud auth application-default login` locally, the Cloud Run service account in prod).
# Never create or download service-account keys.

GCP_PROJECT_ID=audion-511503
# Local dev with your own `gcloud auth application-default login` only (Cloud Run does not need it):
# GOOGLE_CLOUD_QUOTA_PROJECT=audion-511503

# Recognizer: tuned | base | mock. Unset follows MOCK (MOCK=1 gives mock, otherwise base).
RECOGNIZER_MODE=mock
# Numeric ID of the tuned model's endpoint (required when RECOGNIZER_MODE=tuned). Never commit a real one.
# Compare checkpoints with: pnpm --filter @audion/api eval --clips <dir> --endpoint <id> --yes
TUNED_ENDPOINT_ID=
TUNED_LOCATION=us                  # tuned endpoints sit in the multi-region "us", not us-central1
BASE_MODEL=gemini-3.5-flash
BASE_LOCATION=global
RECOGNIZE_MAX_OUTPUT_TOKENS=2048   # Gemini 3.5 Flash thinks first; small values return empty answers
RECOGNIZE_TIMEOUT_MS=15000         # the tuned endpoint took 10-17 s per clip when probed: use 60000 with it
RECOGNIZE_THINKING_LEVEL=          # minimal|low|medium|high; minimal is faster. Unset = model default (slowest)
RECOGNIZER_FALLBACK=none           # base = answer with the base model if the tuned call fails (off for testing)
WARM_UP=1                          # live mode: one tiny request per service at start so the first sign is not slow
DAILY_CALL_CAP=500                 # cost guard: paid recognition calls per UTC day per instance
COMPOSE_MODEL=gemini-3.5-flash
COMPOSE_LOCATION=global
COMPOSE_THINKING_LEVEL=            # minimal|low|medium|high; minimal cut compose from ~2.2 s to ~1 s. Unset = model default
CONFIDENCE_THRESHOLD=0.5
MOCK=0

# API server
PORT=8080
# Required when MOCK=0 (the API refuses the public development default). Use Secret Manager in production.
JWT_SECRET=change-me-locally-use-secret-manager-in-prod
# Required when MOCK=0. '*' is for local testing only.
ALLOWED_ORIGINS=chrome-extension://<your-extension-id>

# Extension build (read at build time, not runtime)
VITE_API_URL=http://localhost:8080

# cloud = Google Cloud Text-to-Speech, mock = placeholder tone. Unset follows MOCK.
# Use MOCK=1 with SPEAKER_MODE=cloud to hear the real voices while recognition stays mock.
# SPEAKER_MODE=cloud

# Meeting summaries (POST /v1/context) are a Gemini call each, so their per-install limit is lower than the rest.
# RATE_LIMIT_CONTEXT_PER_INSTALL_PER_MIN=6
