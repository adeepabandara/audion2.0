# Copy to .env for local development. Never commit .env.
# The API authenticates to Google with Application Default Credentials
# (`gcloud auth application-default login` locally, the Cloud Run service account in prod).
# Never create or download service-account keys.

GCP_PROJECT=audion-511503
RECOGNIZE_MODEL=gemini-3.5-flash   # replace with the tuned model/endpoint resource name when ready
RECOGNIZE_LOCATION=global          # us-central1 for the tuned endpoint
COMPOSE_MODEL=gemini-3.5-flash
COMPOSE_LOCATION=global
CONFIDENCE_THRESHOLD=0.5
MOCK=0

# API server
PORT=8080
JWT_SECRET=change-me-locally-use-secret-manager-in-prod
ALLOWED_ORIGINS=chrome-extension://<your-extension-id>

# Extension build (read at build time, not runtime)
VITE_API_URL=http://localhost:8080
