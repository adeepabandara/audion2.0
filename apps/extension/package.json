    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.24.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/chrome": "0.3.5",
    "@types/node": "26.6.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "30.1.2",
    "typescript": "5.7.2",
    "vite": "7.3.7",
